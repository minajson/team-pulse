# TEAM PULSE — environment
#
# Every value here is optional. With an empty .env the app runs fully: sessions
# live in the server process and are snapshotted to ./.data/sessions.json, which
# is the right shape for the way this product is actually used — one facilitator,
# one room, one server.

# Switches the store to Postgres. Set this for multi-instance hosting, or when
# sessions need to outlive the server. Works with any Postgres 13+, including
# the database behind a Supabase project (use the connection string from
# Project Settings → Database → Connection string → URI).
#
# The schema in src/lib/store/schema.sql is applied automatically on first use;
# apply it by hand if the role lacks DDL rights:
#   psql "$TEAM_PULSE_DATABASE_URL" -f src/lib/store/schema.sql
#
# TEAM_PULSE_DATABASE_URL=postgres://user:password@host:5432/database

# Connection pool size for the Postgres driver. Default 10.
# TEAM_PULSE_PG_POOL=10

# Where the in-process driver writes its snapshot. Default ./.data
# TEAM_PULSE_DATA_DIR=./.data
